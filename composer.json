{
    "name": "reighfer/sam10-serverless-payroll",
    "description": "Serverless PHP Payroll System on AWS Lambda using Bref",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "bref/bref": "^3.0",
        "bramus/router": "^1.6",
        "aws/aws-sdk-php": "^3.300",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.12"
        },
        "platform-check": false,
        "allow-plugins": {
            "bref/bref": true
        }
    }
}
